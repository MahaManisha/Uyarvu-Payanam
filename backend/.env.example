# MongoDB Connection String (e.g., MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/uyarvuPayanam?retryWrites=true&w=majority

# Port (Render sets this automatically, default 5000 for local)
PORT=5000

# Environment mode
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Admin Secret Key
ADMIN_SECRET_KEY=your_admin_secret_key

# Frontend URL (Your deployed Vercel domain)
FRONTEND_URL=https://your-frontend-app.vercel.app

# Groq AI API Key for Question Generation & Summaries
GROQ_API_KEY=your_groq_api_key_here
AI_QUESTIONS_MODEL=openai/gpt-oss-120b

# Email Configuration (Brevo SMTP or Gmail)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_smtp_user
MAIL_PASS=your_smtp_pass
MAIL_FROM=your_email@example.com
